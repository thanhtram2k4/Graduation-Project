  m_Script: {fileID: 11500000, guid: cbb4df94e5a55d64ab78b56ec3baa0b5, type: 3}
  m_Name: Q2
  m_EditorClassIdentifier: Assembly-CSharp::HistoricalQuestionData
  questionID: Q2
  questionText: In the Battle of Bach Dang in 938, which general used the stratagem
    of planting iron-clad wooden stakes in the riverbed?
  answers:
  - Ly Thuong Kiet
  - Tran Hung Dao
  - Ngo Quyen
  - Quang Trung
  correctAnswerIndex: 0
  answerFeedbacks:
  - Wrong! Ly Thuong Kiet is famous for the battle of Nhu Nguyet River and the poem
    Nam Quoc Son Ha.
  - Wrong! King Hung Dao also used stakes at Bach Dang, but it was to fight the Mongol
    army in 1288.
  - Exactly! Ngo Quyen's strategy of iron-clad wooden stakes buried the Southern
    Han army, ushering in an era of independence.
  - Wrong! King Quang Trung (Nguyen Hue) is associated with the victory at Ngoc Hoi
    - Dong Da, decisively defeating the Qing army.
  difficultyTier: 1
